# Environment / secrets — nunca versionar
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
*.egg-info/
dist/
build/

# Node
node_modules/
apps/web/dist/
*.tsbuildinfo

# Runtime assets — manter estrutura, ignorar conteúdo
assets/originals/*
!assets/originals/.gitkeep
assets/derived/*
!assets/derived/.gitkeep
assets/cache/*
!assets/cache/.gitkeep
assets/exports/*
!assets/exports/.gitkeep
assets/temp/*
!assets/temp/.gitkeep

# Backups & logs
*.log
*.sql.gz
*.dump

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
.pytest_tmp/
.pytest_tmp/

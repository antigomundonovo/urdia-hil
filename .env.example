APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
WEB_PORT=5173
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://urdia:${POSTGRES_PASSWORD}@localhost:5432/urdia
ASSET_ROOT=./assets
EXPORT_ROOT=./assets/exports
CACHE_ROOT=./assets/cache
TEMP_ROOT=./assets/temp
DEFAULT_PROFILE_KEY=default
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:5173
# SMTP required for account verification and password recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
SMTP_USE_SSL=false

# LLM provider (Google AI Studio / Gemini). Chave NUNCA versionada (Doc 08).
GOOGLE_AI_API_KEY=
LLM_MODEL=gemini-2.5-flash

# YouTube adapter: cookies da SUA sessão (opcional) — YouTube exige sessão p/ metadados.
# Use UM dos dois:
#YTDLP_COOKIES_FROM_BROWSER=chrome
#YTDLP_COOKIES_FILE=./config/youtube-cookies.txt

# TikTok Content Posting API user access token (never commit the real value).
TIKTOK_ACCESS_TOKEN=
